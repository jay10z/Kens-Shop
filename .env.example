# Public frontend config only — never put service-role keys here.
# GA4 Measurement IDs are intended to be public (visible in the browser).

VITE_GA_MEASUREMENT_ID=G-B904SNSRN5

# --- Required for the storefront (Vite) ---
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Required for Vercel serverless APIs (server-only; never VITE_*) ---
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin allowlist (server-only). Comma-separated emails.
# Must include the existing shop owner account before deploy.
# ADMIN_EMAILS=owner@example.com
