# =============================================================================
# Ken's Shop — Environment Variables
# Copy this file to `.env` for local development and fill in real values.
# Never commit `.env` or real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
# Project URL from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / publishable key (safe for browser; still do not commit real values)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key (server-only — NEVER expose to the browser or VITE_/NEXT_PUBLIC_)
# Required by Vercel API routes in /api and by seed scripts
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional alias used only by extract_data.js (falls back unused if unset)
# SUPABASE_URL=https://your-project-ref.supabase.co

# -----------------------------------------------------------------------------
# Supabase Storage (required for admin image uploads)
# -----------------------------------------------------------------------------
# Create a public bucket named exactly:
#   product-images
# in Supabase → Storage. The upload API uses this hard-coded bucket name.
# SUPABASE_STORAGE_BUCKET=product-images

# -----------------------------------------------------------------------------
# Google Auth (optional / currently unused by the main app routes)
# Present in src/lib/googleAuth.ts and legacy vercel.json entries.
# Safe to leave blank unless you wire Google sign-in back in.
# -----------------------------------------------------------------------------
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# VITE_GOOGLE_AUTH_PROXY=https://your-domain.com/auth/google/callback

# -----------------------------------------------------------------------------
# Paused-project restore helpers (optional)
# Used by api/db-wake.js when the DB returns 5xx (e.g. paused Supabase project).
# Not required for a standard always-on production deployment.
# -----------------------------------------------------------------------------
# FULLSTACK_PROJECT_REF=your-project-ref
# FULLSTACK_RESTORE_API_URL=https://your-restore-endpoint.example/api/fullstack-restore
